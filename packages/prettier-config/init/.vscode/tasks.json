{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "ksc-prettier lint",
			"detail": "Check that files are formatted according to your Prettier configuration.",
			"type": "shell",
			"command": "pnpm exec ksc-prettier lint --format machine",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"presentation": {
				"clear": true,
				"echo": true,
				"focus": false,
				"panel": "dedicated",
				"reveal": "silent",
				"revealProblems": "onProblem",
				"showReuseMessage": false
			},
			"problemMatcher": [
				{
					"owner": "ksc",
					"source": "ksc",
					"fileLocation": ["relative", "${workspaceFolder}"],
					"pattern": {
						"regexp": "^(.+?):(\\d+):(\\d+): (error|warning|info): (.+) \\[([^\\]]+)\\]$",
						"file": 1,
						"line": 2,
						"column": 3,
						"severity": 4,
						"message": 5,
						"code": 6
					}
				}
			]
		},
		{
			"label": "ksc-prettier fix",
			"detail": "Format files according to your Prettier configuration.",
			"type": "shell",
			"command": "pnpm exec ksc-prettier fix --format machine",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"presentation": {
				"clear": true,
				"echo": true,
				"focus": false,
				"panel": "dedicated",
				"reveal": "silent",
				"revealProblems": "onProblem",
				"showReuseMessage": false
			},
			"problemMatcher": [
				{
					"owner": "ksc",
					"source": "ksc",
					"fileLocation": ["relative", "${workspaceFolder}"],
					"pattern": {
						"regexp": "^(.+?):(\\d+):(\\d+): (error|warning|info): (.+) \\[([^\\]]+)\\]$",
						"file": 1,
						"line": 2,
						"column": 3,
						"severity": 4,
						"message": 5,
						"code": 6
					}
				}
			]
		}
	]
}
