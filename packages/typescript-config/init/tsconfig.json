{
	"extends": "@kitschpatrol/typescript-config",
	"compilerOptions": {
		// TypeScript 6.0 no longer includes @types packages automatically
		"types": ["node"]
		// Consider enabling for new projects
		// https://www.typescriptlang.org/tsconfig/#exactOptionalPropertyTypes
		// "exactOptionalPropertyTypes": true
	},
	// Includes project dot-files files for typescript-eslint integration
	"include": ["**/*", "**/**.*"],
	"exclude": ["**/dist/"]
}
