{
	"name": "@kitschpatrol/shared-config",
	"version": "8.7.0",
	"description": "A collection of shared configurations, linters, and formatting tools for TypeScript projects. All managed as a single dependency. All invoked via a single CLI command.",
	"keywords": [
		"shared-config",
		"eslint-config",
		"stylelint-config",
		"prettier-config",
		"typescript-config",
		"remark-config",
		"remark-lint",
		"github-actions",
		"cspell",
		"tsconfig",
		"eslint",
		"prettier",
		"stylelint",
		"remark",
		"mdat",
		"cli",
		"ksc"
	],
	"homepage": "https://github.com/kitschpatrol/shared-config",
	"bugs": "https://github.com/kitschpatrol/shared-config/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/shared-config.git",
		"directory": "packages/shared-config"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"bin": {
		"ksc": "bin/cli.js"
	},
	"files": [
		"bin/*",
		"dist/*",
		"init/*"
	],
	"scripts": {
		"build": "tsdown",
		"cli": "node ./bin/cli.js",
		"prepublishOnly": "pnpm build",
		"test": "vitest run"
	},
	"dependencies": {
		"@kitschpatrol/cspell-config": "workspace:*",
		"@kitschpatrol/eslint-config": "workspace:*",
		"@kitschpatrol/knip-config": "workspace:*",
		"@kitschpatrol/mdat-config": "workspace:*",
		"@kitschpatrol/prettier-config": "workspace:*",
		"@kitschpatrol/remark-config": "workspace:*",
		"@kitschpatrol/repo-config": "workspace:*",
		"@kitschpatrol/stylelint-config": "workspace:*",
		"@kitschpatrol/typescript-config": "workspace:*",
		"@pinojs/json-colorizer": "^4.0.0",
		"@pnpm/lockfile.fs": "^1100.2.4",
		"cosmiconfig": "^10.0.0",
		"cosmiconfig-typescript-loader": "^6.3.0",
		"cspell": "^10.1.1",
		"cspell-config-lib": "^10.1.1",
		"cspell-lib": "^10.1.1",
		"decircular": "^1.0.0",
		"deepmerge": "^4.3.1",
		"deepmerge-ts": "^8.0.2",
		"execa": "^10.0.1",
		"find-workspaces": "^0.3.1",
		"fs-extra": "^11.4.0",
		"globby": "^16.2.4",
		"json-stringify-pretty-compact": "^4.0.0",
		"magicast": "^0.5.4",
		"mdat": "^3.1.0",
		"package-up": "^5.0.0",
		"picocolors": "^1.1.1",
		"prettier": "^3.9.6",
		"semver": "^7.8.5",
		"stylelint": "^17.14.1",
		"yargs": "^18.1.0"
	},
	"engines": {
		"node": "^24.16.0 || >=26.3.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
